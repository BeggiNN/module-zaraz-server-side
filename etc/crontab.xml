<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="perspective_zaraz_server_send"
             instance="Perspective\ZarazServerSide\Cron\SendEvents"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <job name="perspective_zaraz_server_cleanup"
             instance="Perspective\ZarazServerSide\Cron\Cleanup"
             method="execute">
            <schedule>17 3 * * *</schedule>
        </job>
    </group>
</config>
